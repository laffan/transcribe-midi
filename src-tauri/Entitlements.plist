<?xml version="1.0" encoding="UTF-8"?>
<!--
  App Sandbox entitlements for the macOS build.

  `device.audio-input` is what lets a sandboxed build reach the microphone at all; the
  usage description in Info.plist governs the prompt, but without this the prompt is
  never reached. `user-selected.read-write` covers Export and Import, which reach the
  filesystem only through a save or open panel.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>

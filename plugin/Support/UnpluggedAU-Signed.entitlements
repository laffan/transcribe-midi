<?xml version="1.0" encoding="UTF-8"?>
<!--
  The extension's entitlements for a signed build — the `Signed` configuration.

  This is the shipping arrangement. The App Group is the load-bearing part: a sandboxed
  app and a sandboxed app extension get *separate containers*, so without a group shared
  with the app the plugin cannot see the projects the app wrote — and the symptom is an
  empty project list with no error, which looks exactly like "the app has never run".

  The same group has to be on the app's entitlements (src-tauri/Entitlements-Signed.plist)
  and on the host stub's, and all of them have to be in the same team. Getting one of the
  three wrong is the most likely reason a correctly-built plugin shows nothing.

  Building against this needs a paid Apple Developer membership: App Groups cannot be
  registered on a free Apple ID, and Xcode requires a matching provisioning profile.

      UNPLUGGED_TEAM_ID=XXXXXXXXXX scripts/install-plugin.sh --signed
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.unplugged.daw</string>
	</array>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>

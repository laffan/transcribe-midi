<?xml version="1.0" encoding="UTF-8"?>
<!--
  The extension's entitlements.

  The App Group is the load-bearing one. An app extension gets its own sandboxed
  container, so without a group shared with the container app the plugin cannot see the
  projects the app wrote — and the symptom is an empty project list with no error, which
  looks exactly like "the app has never run".

  The same group has to be on the app's entitlements, and both have to be in the same
  team. Getting one of the two wrong is the most likely reason a correctly-built plugin
  shows nothing.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.unplugged.daw</string>
	</array>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>

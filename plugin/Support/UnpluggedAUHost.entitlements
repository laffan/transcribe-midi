<?xml version="1.0" encoding="UTF-8"?>
<!--
  The container app's entitlements.

  Must declare the same App Group as the extension and as the Tauri app's
  Entitlements.plist. All three, in the same team, or the extension sees an empty projects
  list with nothing to explain why.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.unplugged.daw</string>
	</array>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
